# ─────────────────────────────────────────────────────────────────────────────
# FULLSTORY configuration. Every integration is optional in development:
# with nothing set, the app uses an embedded Postgres (PGlite), local file
# storage in ./.data and email/password accounts stored in that database.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (used for payment redirects and share links)
APP_URL=http://localhost:3000

# Secret for signing session/share cookies (required in production with local auth)
SESSION_SECRET=change-me-to-a-long-random-string

# ── Supabase (production) ────────────────────────────────────────────────────
# Connecting Supabase from the Vercel Marketplace sets these automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection (pooled). The schema is migrated automatically on first use.
POSTGRES_URL=
# Storage bucket for photos and exports (created automatically, private)
SUPABASE_STORAGE_BUCKET=fullstory
# Force local email/password accounts even when Supabase is configured
# AUTH_PROVIDER=local

# ── Payments ─────────────────────────────────────────────────────────────────
# stripe | test   (test is refused in production unless ALLOW_TEST_PAYMENTS=true)
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_AUTOMATIC_TAX=true
# ALLOW_TEST_PAYMENTS=false

# ── Operations ───────────────────────────────────────────────────────────────
# Comma-separated emails that can open /admin/orders (fulfilment, print files, refunds)
ADMIN_EMAILS=

# Optional: override the product catalog (prices, sizes, covers, shipping) with JSON
# FULLSTORY_CATALOG_JSON=
